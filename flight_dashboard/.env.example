# Copy to .env (gitignored) and fill in. Never commit real coordinates.
HOME_LAT=
HOME_LON=

# Optional
# DASHBOARD_TITLE=My ADS-B Radar
# PORT=8080
# HOST=0.0.0.0            # address to listen on
# DEMO_MODE=false         # true = built-in sample traffic, no receiver needed
# SEEN_THRESHOLD=120      # seconds since last contact before a plane leaves the map

# Map
# MAP_RANGE_MI=25         # miles from the antenna to the edge of the screen
# RANGE_RINGS_MI=5,10,20
# TRAIL_SECONDS=300       # length of the trail behind each plane
# MAP_RADIUS_MI=80        # used by download_map.py: miles of map to store
# MAP_MAX_ZOOM=12         # used by download_map.py: deepest zoom to store

# Alerts
# STALL_SECONDS=180       # no new messages for this long shows "No signal"

# Route and photo lookups (adsbdb.com and planespotters.net)
# LOOKUPS=true            # false = stay offline
# CONTACT_URL=            # sent to those services so they can reach you; defaults to this repo
